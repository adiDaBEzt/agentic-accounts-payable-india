# --- IBM watsonx Orchestrate ---
WXO_INSTANCE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_API_KEY=<ibm-cloud-api-key>

# --- Odoo ERP (XML-RPC) ---
ODOO_URL=https://<your-db>.odoo.com
ODOO_DB=<your-db>
ODOO_USERNAME=<login-email>
ODOO_PASSWORD=<password-or-api-key>

# --- Gmail AP inbox (IMAP/SMTP with an app password) ---
GMAIL_USER=ap-inbox.placeholder@gmail.com
GMAIL_APP_PASSWORD=
# Poll the inbox every N seconds (0 = only on "Check AP inbox")
GMAIL_POLL_SECONDS=0
# Send all supplier emails here during demos instead of the vendor's address
VENDOR_EMAIL_OVERRIDE=

# --- AP policy ---
PRICE_TOLERANCE_PCT=2.0
